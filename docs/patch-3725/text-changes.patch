+	if type(value) ~= "string" then
+		return false
+	end
+	if value:sub(1, 1) == "." then
+		value = value:sub(2)
+	end
+	if value == "" or value:sub(1, 1) == "."
+		or value:sub(-1) == "." or value:find("..", 1, true) then
+		return false
+	end
+	local count = 0
+	for part in value:gmatch("[^.]+") do
+		if not part:match("^%d+$") then
+			return false
+		end
+		count = count + 1
+	end
+	return count > 0
