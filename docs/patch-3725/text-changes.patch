@@ -33,6 +33,46 @@
 #解码
 url_decode()
 {	
-	local str=$(eval echo $\'${1//%/\\x}\')
-	echo "${str//[\"\']}"
+	url_decode_noeval "$1"
 }
+
+# 无 eval 的 URL 解码，保留解码后的原始内容。
+# 与当前 url_encode/url_decode 保持一致：不把 + 转为空格，只处理 %XX。
+url_decode_noeval_raw()
+{
+	local s="$1" out="" prefix hex ch
+
+	while [[ "$s" == *%* ]]; do
+		prefix="${s%%\%*}"
+		out+="$prefix"
+		s="${s#*%}"
+
+		hex="${s:0:2}"
+		if [[ "$hex" =~ ^[0-9A-Fa-f]{2}$ ]]; then
+			printf -v ch '%b' "\\x$hex"
+			out+="$ch"
+			s="${s:2}"
+		else
+			hex="${s:0:1}"
+			if [[ "$hex" =~ ^[0-9A-Fa-f]$ ]]; then
+				printf -v ch '%b' "\\x$hex"
+				out+="$ch"
+				s="${s:1}"
+			else
+				out+="%"
+			fi
+		fi
+	done
+
+	printf '%s\n' "$out$s"
+}
+
+# 无 eval 的 URL 解码，兼容旧 url_decode 行为：解码后删除单双引号。
+url_decode_noeval()
+{
+	local str
+	str="$(url_decode_noeval_raw "$1")"
+	str="${str//\"/}"
+	str="${str//\'/}"
+	printf '%s\n' "$str"
+}
