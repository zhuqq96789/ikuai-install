+CONSOLE_SSH_ALLOWLIST_ENC="/etc/ssl/default/console_ssh_allowlist.enc"
+CONSOLE_SSH_ALLOWLIST_SIG="/etc/ssl/default/console_ssh_allowlist.sig"
+CONSOLE_SSH_PUBLIC_ALLOWLIST=""
+
+
+WHOAMI_FAIL_COUNT_FILE="/tmp/console_whoami_fail_count"
+WHOAMI_FAIL_LOCK_DIR="/tmp/console_whoami_fail_count.lock"
+
+record_whoami_failure()
+{
+	local count tmp
+
+	mkdir "$WHOAMI_FAIL_LOCK_DIR" 2>/dev/null || return 1
+
+	count=$(cat "$WHOAMI_FAIL_COUNT_FILE" 2>/dev/null)
+	[[ "$count" =~ ^[0-9]+$ ]] || count=0
+	count=$((count+1))
+
+	tmp=$(mktemp /tmp/console-whoami-fail-count.XXXXXX) || {
+		rmdir "$WHOAMI_FAIL_LOCK_DIR" 2>/dev/null || :
+		return 1
+	}
+	if ! printf "%s\n" "$count" > "$tmp"; then
+		rm -f "$tmp"
+		rmdir "$WHOAMI_FAIL_LOCK_DIR" 2>/dev/null || :
+		return 1
+	fi
+	chmod 0600 "$tmp"
+	if ! mv -f "$tmp" "$WHOAMI_FAIL_COUNT_FILE"; then
+		rm -f "$tmp"
+		rmdir "$WHOAMI_FAIL_LOCK_DIR" 2>/dev/null || :
+		return 1
+	fi
+	rmdir "$WHOAMI_FAIL_LOCK_DIR" 2>/dev/null || :
+}
+
+
+get_device_gwid()
+{
+	local device_gwid
+	device_gwid=$(awk -F= '$1=="GWID"{print $2; exit}' "$CONSOLE_RELEASE_FILE" 2>/dev/null | tr 'A-F' 'a-f')
+	[[ "$device_gwid" =~ ^[0-9a-f]+$ ]] && [ "${#device_gwid}" -eq 32 ] || return 1
+	printf '%s' "$device_gwid"
+}
+
+GWID=$(get_device_gwid 2>/dev/null)
+
+load_console_ssh_allowlist()
+{
+	local decrypted derive_key
+	CONSOLE_SSH_PUBLIC_ALLOWLIST=""
+	[ -r "$CONSOLE_SSH_ALLOWLIST_ENC" ] || return 1
+	[ -r "$CONSOLE_SSH_ALLOWLIST_SIG" ] || return 1
+	[ -r "$WHOAMI_PUBLIC_KEY" ] || return 1
+
+	# The public key derives the package wrapping key; authenticity comes from
+	# the ECDSA signature below. No allowlist plaintext is shipped in the image.
+	derive_key=$(openssl dgst -sha256 "$WHOAMI_PUBLIC_KEY" 2>/dev/null |
+		awk '{print $NF}')
+	[[ "$derive_key" =~ ^[0-9a-fA-F]{64}$ ]] || return 1
+	decrypted=$(mktemp /tmp/console-ssh-allowlist.XXXXXX) || return 1
+	if ! openssl enc -d -aes-256-cbc -in "$CONSOLE_SSH_ALLOWLIST_ENC" \
+		-out "$decrypted" -pass "pass:$derive_key" >/dev/null 2>&1; then
+		rm -f "$decrypted"
+		return 1
+	fi
+	if ! openssl dgst -sha256 -verify "$WHOAMI_PUBLIC_KEY" \
+		-signature "$CONSOLE_SSH_ALLOWLIST_SIG" "$decrypted" >/dev/null 2>&1; then
+		rm -f "$decrypted"
+		return 1
+	fi
+	CONSOLE_SSH_PUBLIC_ALLOWLIST=$(cat "$decrypted")
+	rm -f "$decrypted"
+	[ -n "$CONSOLE_SSH_PUBLIC_ALLOWLIST" ]
+}
+
+load_console_ssh_allowlist || CONSOLE_SSH_PUBLIC_ALLOWLIST=""
+
+
+ipv4_to_u32()
+{
+	local ip="$1"
+	local first second third fourth part value=0
+	IFS=. read -r first second third fourth <<< "$ip"
+	for part in "$first" "$second" "$third" "$fourth"; do
+		[[ "$part" =~ ^[0-9]{1,3}$ ]] && [ "$part" -le 255 ] || return 1
+		value=$(( (value << 8) | 10#$part ))
+	done
+	printf '%u' "$value"
+}
+
+ipv4_cidr_match()
+{
+	local source_ip="$1"
+	local network="$2"
+	local network_ip prefix source_value network_value mask
+	if [[ "$network" == */* ]]; then
+		network_ip="${network%/*}"
+		prefix="${network#*/}"
+		[[ "$prefix" =~ ^[0-9]+$ ]] && [ "$prefix" -le 32 ] || return 1
+	else
+		network_ip="$network"
+		prefix=32
+	fi
+	source_value=$(ipv4_to_u32 "$source_ip") || return 1
+	network_value=$(ipv4_to_u32 "$network_ip") || return 1
+	if [ "$prefix" -eq 0 ]; then
+		return 0
+	fi
+	mask=$(( (4294967295 << (32 - prefix)) & 4294967295 ))
+	[ $((source_value & mask)) -eq $((network_value & mask)) ]
+}
+
+get_ssh_source_ip()
+{
+	local source_ip
+	[ -n "$SSH_CONNECTION" ] || return 1
+	source_ip=$(printf '%s\n' "$SSH_CONNECTION" | awk 'NF >= 4 {print $1; exit}')
+	ipv4_to_u32 "$source_ip" >/dev/null || return 1
+	printf '%s' "$source_ip"
+}
+
+get_ssh_route_device()
+{
+	local source_ip="$1"
+	ip route get "$source_ip" 2>/dev/null |
+		awk '{for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i + 1); exit}}'
+}
+
+is_ssh_ip_allowlisted()
+{
+	local source_ip="$1"
+	local entry
+	while IFS= read -r entry || [ -n "$entry" ]; do
+		entry="${entry%%#*}"
+		entry="${entry//[[:space:]]/}"
+		[ -n "$entry" ] || continue
+		ipv4_cidr_match "$source_ip" "$entry" && return 0
+	done <<< "$CONSOLE_SSH_PUBLIC_ALLOWLIST"
+	return 1
+}
+
+is_ssh_whoami_allowed()
+{
+	local source_ip route_device
+	source_ip=$(get_ssh_source_ip) || return 1
+	route_device=$(get_ssh_route_device "$source_ip")
+	[ -n "$route_device" ] || return 1
+	case "$route_device" in
+		wan*|vwan*|adsl*)
+			is_ssh_ip_allowlisted "$source_ip"
+			;;
+		*)
+			return 0
+			;;
+	esac
+}
+
+is_local_console()
+{
+	[ -z "$TELNETD" ] && [ -t 0 ] && [ -t 1 ] || return 1
+	if [ -n "$SSH_CONNECTION" ]; then
+		is_ssh_whoami_allowed
+	else
+		[ -z "$SSH_CLIENT" ] && [[ "$DEVTTY" == /dev/* ]]
+	fi
+}
+
+create_whoami_challenge()
+{
+	local challenge
+	challenge=$(hexdump -n 8 -e '8/1 "%02x"' /dev/urandom 2>/dev/null) || return 1
+	[[ "$challenge" =~ ^[0-9a-f]{16}$ ]] || return 1
+	printf '%s' "$challenge"
+}
+
+hex_to_binary()
+{
+	local hex="$1"
+	local escaped=""
+	local pair
+	while [ -n "$hex" ]; do
+		pair="${hex:0:2}"
+		escaped="${escaped}\\x${pair}"
+		hex="${hex:2}"
+	done
+	printf '%b' "$escaped"
+}
+
+verify_whoami_password()
+{
+	local signature="$1"
+	local challenge="$2"
+	local signature_file verify_status body r_hex s_hex r_der s_der der_hex
+
+	[ -f "$WHOAMI_PUBLIC_KEY" ] || return 1
+	[[ "$GWID" =~ ^[0-9a-f]+$ ]] && [ "${#GWID}" -eq 32 ] || return 1
+	[[ "$challenge" =~ ^[0-9a-f]+$ ]] && [ "${#challenge}" -eq 16 ] || return 1
+	[[ "$signature" =~ ^[0-9a-fA-F]{128}$ ]] || return 1
+	r_hex="${signature:0:64}"
+	s_hex="${signature:64:64}"
+
+	# Rebuild the ASN.1 DER form expected by OpenSSL from fixed-width r||s.
+	der_integer()
+	{
+		local value="$1"
+		while [ "${#value}" -gt 2 ] && [ "${value:0:2}" = "00" ]; do
+			value="${value:2}"
+		done
+		if [[ "${value:0:1}" =~ [89a-fA-F] ]]; then
+			value="00$value"
+		fi
+		printf '02%02x%s' "$(( ${#value} / 2 ))" "$value"
+	}
+	r_der=$(der_integer "$r_hex") || return 1
+	s_der=$(der_integer "$s_hex") || return 1
+	body="$r_der$s_der"
+	der_hex=$(printf '30%02x%s' "$(( ${#body} / 2 ))" "$body")
+	signature_file=$(mktemp /tmp/console-whoami.XXXXXX) || return 1
+	if ! hex_to_binary "$der_hex" > "$signature_file" 2>/dev/null;then
+		rm -f "$signature_file"
+		return 1
+	fi
+	printf '%s' "ikuai-console-v3:$GWID:$challenge" |
+		openssl dgst -sha256 -verify "$WHOAMI_PUBLIC_KEY" -signature "$signature_file" >/dev/null 2>&1
+	verify_status=$?
+	rm -f "$signature_file"
+	return "$verify_status"
+}
 
 
