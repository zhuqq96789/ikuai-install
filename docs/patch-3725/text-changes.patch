 clean_temp_webuser()
 {
 	sqlite3 $IK_DB_CONFIG "delete from webuser where id == 0; delete from usergroup where id == 0;"
+}
+
+# Remove rows containing shell IFS expansion markers before any feature script
+# loads configuration from the database.  This is a startup safety net for a
+# tampered database; individual feature scripts must still avoid eval.
+sanitize_config_db_ifs()
+{
+	local config_db="$IK_DB_CONFIG"
+	local wecom_db="${IK_DB_WECOM:-/etc/mnt/ikuai/wecom.db}"
+	local wpa_ppsk_db="${IK_AC_PSK_DB:-/etc/mnt/ikuai/wpa_ppsk.db}"
+	local docker_db="${IK_DB_DOCKER:-/etc/mnt/ikuai/docker.db}"
+	local max_db_size=$((1 * 1024 * 1024))
+	local bad_marker='${IFS}'
+	local log_file="$IK_DIR_TMP/bootlog/db_sanitize.log"
+	local db db_name db_size line table id deleted delete_output
+	local schema_output schema_line cid column rest checked_tables id_tables
+	local insert_re_quoted insert_re_plain
+	local delete_sql matched_rows deleted_rows skipped_lines
+
+	mkdir -p "${log_file%/*}"
+	: > "$log_file"
+
+	insert_re_quoted='^INSERT[[:space:]]+INTO[[:space:]]+"([A-Za-z_][A-Za-z0-9_]*)"[[:space:]]+VALUES\(([0-9]+),'
+	insert_re_plain='^INSERT[[:space:]]+INTO[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]+VALUES\(([0-9]+),'
+
+	for db in "$config_db" "$wecom_db" "$wpa_ppsk_db" "$docker_db"; do
+		db_name=${db##*/}
+		if [ ! -r "$db" ]; then
+			printf 'database=%s skipped=unreadable\n' "$db_name" >> "$log_file"
+			continue
+		fi
+
+		db_size=$(stat -c %s "$db" 2>/dev/null) || \
+			db_size=$(stat -f %z "$db" 2>/dev/null) || {
+			printf 'database=%s skipped=stat_failed\n' "$db_name" >> "$log_file"
+			continue
+		}
+		if [ "$db_size" -ge "$max_db_size" ]; then
+			printf 'database=%s size=%s skipped=size_limit max_size=%s\n' \
+				"$db_name" "$db_size" "$max_db_size" >> "$log_file"
+			continue
+		fi
+
+		delete_sql="BEGIN IMMEDIATE;"
+		matched_rows=0
+		deleted_rows=0
+		skipped_lines=0
+		checked_tables=""
+		id_tables=""
+		while IFS= read -r line; do
+			if [[ "$line" =~ $insert_re_quoted ]]; then
+				table=${BASH_REMATCH[1]}
+				id=${BASH_REMATCH[2]}
+			elif [[ "$line" =~ $insert_re_plain ]]; then
+				table=${BASH_REMATCH[1]}
+				id=${BASH_REMATCH[2]}
+			else
+				skipped_lines=$((skipped_lines + 1))
+				continue
+			fi
+
+			case "|$checked_tables|" in
+				*"|$table|"*) ;;
+				*)
+					checked_tables="${checked_tables:+$checked_tables|}$table"
+					schema_output=$(sqlite3 -batch "$db" \
+						"PRAGMA table_info(\"$table\");" 2>>"$log_file") || true
+					schema_line=${schema_output%%$'\n'*}
+					IFS='|' read -r cid column rest <<< "$schema_line"
+					[ "$cid" = "0" -a "$column" = "id" ] && \
+						id_tables="${id_tables:+$id_tables|}$table"
+					;;
+			esac
+			case "|$id_tables|" in
+				*"|$table|"*) ;;
+				*)
+					skipped_lines=$((skipped_lines + 1))
+					continue
+					;;
+			esac
+
+			delete_sql+=$'\n'"DELETE FROM \"$table\" WHERE id = $id;"
+			delete_sql+=$'\n'"SELECT '$table|$id|' || changes();"
+			matched_rows=$((matched_rows + 1))
+		done < <(nice -n 19 sqlite3 -batch "$db" ".dump" 2>>"$log_file" | \
+			LC_ALL=C nice -n 19 grep -F "$bad_marker")
+
+		if [ "$matched_rows" -gt 0 ]; then
+			delete_sql+=$'\nCOMMIT;'
+			delete_output=$(sqlite3 -batch -bail -cmd ".timeout 5000" "$db" \
+				<<< "$delete_sql" 2>>"$log_file") || continue
+			while IFS='|' read -r table id deleted; do
+				[[ "$deleted" =~ ^[0-9]+$ ]] || continue
+				deleted_rows=$((deleted_rows + deleted))
+				printf 'database=%s deleted table=%s id=%s rows=%s\n' \
+					"$db_name" "$table" "$id" "$deleted" >> "$log_file"
+			done <<< "$delete_output"
+		fi
+
+		printf 'database=%s size=%s matched_rows=%s deleted_rows=%s skipped_lines=%s marker=%s\n' \
+			"$db_name" "$db_size" "$matched_rows" "$deleted_rows" \
+			"$skipped_lines" "$bad_marker" >> "$log_file"
+	done
+	return 0
 }
 
